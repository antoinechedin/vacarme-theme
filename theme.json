{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"customTemplates": [],
	"patterns": [],
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1100px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "'Avara Bold'",
							"fontStyle": "normal",
							"fontWeight": "normal",
							"src": [
								"file:./fonts/Avara-Bold.woff2"
							]
						},
						{
							"fontFamily": "'Avara Bold'",
							"fontStyle": "italic",
							"fontWeight": "normal",
							"src": [
								"file:./fonts/Avara-BoldItalic.woff2"
							]
						},
						{
							"fontFamily": "'Avara Bold'",
							"fontStyle": "normal",
							"fontWeight": "bold",
							"src": [
								"file:./fonts/Avara-Black.woff2"
							]
						}
					],
					"fontFamily": "'Avara Bold'",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Chris Costello",
							"fontStyle": "normal",
							"fontWeight": "normal",
							"src": [
								"file:./fonts/ChrisCostello_LPT_Regular.woff2"
							]
						},
						{
							"fontFamily": "Chris Costello",
							"fontStyle": "italic",
							"fontWeight": "normal",
							"src": [
								"file:./fonts/ChrisCostello_LPT_Italic.woff2"
							]
						},
						{
							"fontFamily": "Chris Costello",
							"fontStyle": "normal",
							"fontWeight": "bold",
							"src": [
								"file:./fonts/ChrisCostello_LPT_Bold.woff2"
							]
						},
						{
							"fontFamily": "Chris Costello",
							"fontStyle": "italic",
							"fontWeight": "bold",
							"src": [
								"file:./fonts/ChrisCostello_LPT_Bold_Italic.woff2"
							]
						}
					],
					"fontFamily": "Chris Costello",
					"name": "Title",
					"slug": "title"
				}
			]
		},
		"useRootPaddingAwareAlignments": false
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--title)",
					"textTransform": "uppercase"
				}
			}
		},
		"typography": {
			"lineHeight": "1.2"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		}
	],
	"version": 2
}